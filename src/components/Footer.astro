---
import '../styles/tokens-dark-scope.css';
import '../styles/shell.css';
/**
 * The close: the name first, at the full width of the page, then the ways
 * in, then everything else. Dark on every page, including the light-capable
 * legal shell.
 */
import type { MarketingContent } from '../content/types';
import { localePath, type Locale } from '../content/locales';
import {
  ANDROID_BETA_SIGNUP_URL,
  APP_STORE_URL,
  DISCORD_URL,
  DOCS_URL,
  FLUX76_URL,
  GITHUB_URL,
  ISSUES_URL,
  LEGACY_PATH,
  SUPPORT_URL,
  TESTFLIGHT_URL,
} from '../config';
import LocaleSwitcher from './LocaleSwitcher.astro';

interface Props {
  content: MarketingContent;
  locale: Locale;
}

const { content, locale } = Astro.props;
const { actions, footer, nav } = content;
const home = localePath(locale);
const at = (anchor: string) => `${home}${anchor}`;
const privacyPath = locale === 'nl' ? '/privacy-nl.html' : '/privacy.html';
const termsPath = locale === 'nl' ? '/terms-nl.html' : '/terms.html';
const groups = [
  {
    title: footer.groups.product,
    links: [
      { href: at('#product'), label: nav.collect },
      { href: at('#scan'), label: nav.scan },
      { href: at('#editions'), label: nav.editions },
      { href: at('#self-hosted'), label: nav.selfHosted },
      { href: at('#privacy'), label: nav.privacy },
    ],
  },
  {
    title: footer.groups.help,
    links: [
      { href: DOCS_URL, label: nav.docs },
      { href: at('#faq'), label: nav.faq },
      { href: ISSUES_URL, label: actions.issues },
      { href: GITHUB_URL, label: actions.github },
      { href: LEGACY_PATH, label: footer.legacy },
    ],
  },
  {
    title: footer.groups.legal,
    links: [
      { href: privacyPath, label: footer.privacy },
      { href: termsPath, label: footer.terms },
      { href: SUPPORT_URL, label: actions.support },
    ],
  },
];
---

<footer class="footer dv-dark on-navy" id="footer">
  <p class="footer-name" aria-hidden="true">DiscVault</p>

  <div class="grid footer-main">
    <ul class="footer-ways">
      <li>
        <a href={APP_STORE_URL} data-cta="app-store" data-rank="text">
          {actions.appStore}
        </a>
      </li>
      <li>
        <a href={DOCS_URL} data-cta="self-hosted" data-rank="text">
          {actions.selfHost}
        </a>
      </li>
      <li>
        <a href={ANDROID_BETA_SIGNUP_URL} data-cta="android" data-rank="text">
          {actions.android}
        </a>
      </li>
      <li>
        <a href={TESTFLIGHT_URL} data-cta="testflight" data-rank="text">
          {actions.testflight}
        </a>
      </li>
      <li><a href={DISCORD_URL}>{actions.discord}</a></li>
    </ul>

    <div class="footer-groups">
      {
        groups.map(({ title, links }) => (
          <nav class="footer-group small" aria-label={title}>
            <p class="footer-group-title">{title}</p>
            <ul>
              {links.map(({ href, label }) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="grid footer-legal small">
    <p class="footer-tagline">{footer.tagline}</p>
    <p class="footer-made">
      <span>{footer.production}</span>
      <a href={FLUX76_URL} aria-label="Flux76">
        <img
          src="/brand/flux76-wordmark-dark.png"
          width="107"
          height="32"
          alt="Flux76"
          loading="lazy"
          decoding="async"
        />
      </a>
    </p>
    <p class="footer-tmdb note">{footer.tmdb}</p>
    <div class="footer-end">
      <LocaleSwitcher locale={locale} label={content.a11y.language} />
      <a href="#main">{actions.backToTop}</a>
    </div>
  </div>
</footer>
