---
import '../styles/shell.css';
/**
 * The bar: wordmark, docs, language and one action. Plain and sticky. On the
 * homepage the chapter script lets it take the ground and ink of the chapter
 * beneath it; without script it stays navy. The section links live in the
 * hero's swatch column and, below 900 px, in the menu.
 */
import type { Locale } from '../content/locales';
import type { MarketingContent } from '../content/types';
import {
  ANDROID_BETA_SIGNUP_URL,
  APP_STORE_URL,
  DOCS_URL,
  TESTFLIGHT_URL,
} from '../config';
import LocaleSwitcher from './LocaleSwitcher.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';

interface Props {
  content: MarketingContent;
  locale: Locale;
  homePath: string;
}

const { content, locale, homePath } = Astro.props;
const at = (anchor: string) => `${homePath}${anchor}`;
const sections = [
  { href: at('#product'), label: content.nav.collect },
  { href: at('#scan'), label: content.nav.scan },
  { href: at('#editions'), label: content.nav.editions },
  { href: at('#self-hosted'), label: content.nav.selfHosted },
  { href: at('#privacy'), label: content.nav.privacy },
  { href: at('#faq'), label: content.nav.faq },
];
---

<header class="bar on-base" data-bar>
  <a class="bar-brand" href={homePath} aria-label={content.a11y.home}>
    <img src="/brand/discvault-mark-96.png" width="28" height="28" alt="" />
    <span>DiscVault</span>
  </a>

  <div class="bar-tools">
    <a class="bar-link" href={DOCS_URL}>{content.nav.docs}</a>
    <ThemeSwitcher theme={content.theme} />
    <LocaleSwitcher locale={locale} label={content.a11y.language} />
    <a
      class="button button-compact bar-action"
      href={at('#install')}
      data-cta="get"
      data-rank="primary"
    >
      {content.nav.get}
    </a>
    <details class="menu">
      <summary>{content.a11y.menu}</summary>
      <nav class="menu-sheet" aria-label={content.a11y.menu}>
        <a
          class="button menu-action"
          href={at('#install')}
          data-cta="get"
          data-rank="primary"
        >
          {content.nav.get}
        </a>
        {sections.map(({ href, label }) => <a href={href}>{label}</a>)}
        <a href={DOCS_URL}>{content.nav.docs}</a>
        <ThemeSwitcher theme={content.theme} />
        <a href={APP_STORE_URL} data-cta="app-store" data-rank="text">
          {content.actions.appStore}
        </a>
        <a href={ANDROID_BETA_SIGNUP_URL} data-cta="android" data-rank="text">
          {content.actions.android}
        </a>
        <a href={TESTFLIGHT_URL} data-cta="testflight" data-rank="text">
          {content.actions.testflight}
        </a>
      </nav>
    </details>
  </div>
</header>
