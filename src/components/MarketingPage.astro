---
import '../styles/tokens-dark-pin.css';
import '../styles/cinematic.css';
import '../styles/reels/reels.css';
import type { Locale } from '../content/locales';
import type { MarketingContent } from '../content/types';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './reels/Hero.astro';
import Shelf from './reels/Shelf.astro';
import Read from './reels/Read.astro';
import Edition from './reels/Edition.astro';
import Vault from './reels/Vault.astro';
import Formats from './reels/Formats.astro';

interface Props {
  content: MarketingContent;
  locale: Locale;
  homePath: string;
}

const { content, locale, homePath } = Astro.props;
---

<Header content={content} locale={locale} homePath={homePath} />

<main id="main">
  <Hero content={content} />
  <Shelf content={content} />
  <Read content={content} />
  <Edition content={content} />
  <Vault content={content} locale={locale} />
  <Formats content={content} />
</main>

<Footer content={content} locale={locale} />
