---
/**
 * The disc, held: a stack of material layers (hero.md §5). Body, grooves on
 * the lit half, the spectrum wedge that counter-rotates against the tilt,
 * the track texture over it, the idle pass, the hub, and the sweep overlay
 * the key light is brought up through. The tilt reads --tx/--ty on the
 * root, written by the motion script; without it the disc holds at rest.
 * Decorative throughout.
 */
---

<div class="reflection" aria-hidden="true"></div>
<div class="scene" aria-hidden="true">
  <div class="scroller">
    <div class="tilt">
      <div class="settle">
        <div class="disc">
          <div class="grooves"></div>
          <div class="spectrum"></div>
          <div class="tracks"></div>
          <div class="pass"></div>
          <div class="hub"></div>
          <div class="sweep"></div>
        </div>
      </div>
    </div>
  </div>
</div>
