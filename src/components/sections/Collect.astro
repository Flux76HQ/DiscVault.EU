---
import '../../styles/sections/collect.css';
/** Chapter: what DiscVault keeps. A pinned heading; the capabilities pass. */
import { featureIds } from '../../content/structure';
import type { MarketingContent } from '../../content/types';
import Media from '../media/Media.astro';

interface Props {
  content: MarketingContent;
}

const { collect } = Astro.props.content;
---

<section class="chapter collect on-slate" id="product" data-chapter="on-slate">
  <div class="grid">
    <h2 class="title collect-title" data-rise>{collect.title}</h2>
    <div class="collect-blocks">
      {
        featureIds.map((id, index) => {
          const block = collect.blocks[id];
          return (
            <article
              class:list={[
                'collect-block',
                { 'collect-block-flip': index % 2 === 1 },
              ]}
              data-rise-group
            >
              <h3 class="collect-block-title" data-rise>
                {block.title}
              </h3>
              <div class="collect-row">
                <Media
                  slot={`collect-${id}`}
                  alt={block.mediaAlt}
                  ratio="3 / 4"
                  sizes="(min-width: 56.25rem) 20vw, 100vw"
                  widths={[320, 480, 720, 960]}
                  class="collect-shot"
                />
                <ul class="collect-points" data-rise>
                  {block.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
