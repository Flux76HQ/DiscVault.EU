---
import '../../styles/sections/plans.css';
/** Chapter: what it costs, as one sentence. */
import type { MarketingContent } from '../../content/types';
import { SUPPORT_URL } from '../../config';

interface Props {
  content: MarketingContent;
}

const { plans, actions } = Astro.props.content;
// Chinese, Japanese and Korean set no space between the words of a sentence.
const gap = /[\u3000-\u9fff\uac00-\ud7af]$/.test(plans.titleStart.trim())
  ? ''
  : ' ';
---

<section class="chapter plans on-white" id="plans" data-chapter="on-white">
  <div class="grid">
    <h2 class="display plans-title" data-rise>
      {plans.titleStart.trim()}{gap}<span class="plans-free"
        >{plans.titleFree}</span
      >{plans.titleEnd}
    </h2>
    <p class="statement plans-lead" data-rise>{plans.lead}</p>
    <ul class="plans-points" data-rise>
      {plans.points.map((point) => <li>{point}</li>)}
    </ul>
    <div class="plans-support" data-rise>
      <p>{plans.support}</p>
      <a class="button button-quiet" href={SUPPORT_URL}>{actions.support}</a>
    </div>
  </div>
</section>
