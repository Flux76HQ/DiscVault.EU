---
import '../styles/tokens.css';
import '../styles/theme.css';
import '../styles/fonts.css';
import '../styles/base.css';
import { localeCodes, localePath, ogLocale } from '../content/locales';
import type { MarketingContent } from '../content/types';
import tokens from '../design/tokens.json';
import { APP_STORE_URL, DOCS_URL, SITE_URL } from '../config';
import { faqIds } from '../content/structure';

interface Props {
  content: MarketingContent;
  canonicalPath: string;
  title?: string;
  description?: string;
  noindex?: boolean;
  productSchema?: boolean;
  alternateLinks?: Array<{ locale: string; path: string }>;
  xDefaultPath?: string;
}

const {
  content,
  canonicalPath,
  title = content.seo.title.startsWith('DiscVault')
    ? content.seo.title
    : `${content.seo.title} | DiscVault`,
  description = content.seo.description,
  noindex = false,
  productSchema = true,
  alternateLinks = localeCodes.map((locale) => ({
    locale,
    path: localePath(locale),
  })),
  xDefaultPath = '/',
} = Astro.props;
// Applied before first paint, so a stored light or dark choice never
// flashes the other scheme. With no stored choice the page follows the
// system. Storage failures are ignored.
const themeScript =
  "try{var t=localStorage.getItem('dv-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}";
const canonical = new URL(canonicalPath, SITE_URL).href;
const iconImage = new URL('/brand/discvault-icon-512-dark.png', SITE_URL).href;
// The marketing routes share a 1200 × 630 social image; the legal shell
// keeps the icon.
const socialImage = !productSchema
  ? { url: iconImage, width: 512, height: 512 }
  : {
      url: new URL('/brand/og-discvault.jpg', SITE_URL).href,
      width: 1200,
      height: 630,
    };
// Home pages describe both editions and the questions they answer on the
// page itself; the FAQ entries are generated from the copy that is rendered.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${SITE_URL}/#product`,
      name: 'DiscVault',
      description,
      url: canonical,
      image: iconImage,
      applicationCategory: 'LifestyleApplication',
      operatingSystem: 'iOS, iPadOS',
      downloadUrl: APP_STORE_URL,
      installUrl: APP_STORE_URL,
      inLanguage: content.locale,
      brand: { '@type': 'Brand', name: 'DiscVault' },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${SITE_URL}/#self-hosted`,
      name: 'DiscVault (self-hosted)',
      description: content.selfHosted.lead,
      url: canonical,
      image: iconImage,
      applicationCategory: 'LifestyleApplication',
      operatingSystem: 'Docker, Unraid, Home Assistant',
      downloadUrl: DOCS_URL,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      brand: { '@type': 'Brand', name: 'DiscVault' },
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      inLanguage: content.locale,
      mainEntity: faqIds.map((id) => ({
        '@type': 'Question',
        name: content.faq.items[id].question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: content.faq.items[id].answer.join(' '),
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={content.locale} data-accent="bluray">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta
      name="theme-color"
      content={tokens.pwa['theme-color-dark'].$value}
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content={tokens.pwa['theme-color-light'].$value}
      media="(prefers-color-scheme: light)"
    />
    <script is:inline set:html={themeScript} />
    <link
      rel="preload"
      href="/fonts/inter-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {
      alternateLinks.map(({ locale, path }) => (
        <link
          rel="alternate"
          hreflang={locale}
          href={new URL(path, SITE_URL).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(xDefaultPath, SITE_URL).href}
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/brand/discvault-icon-192.png"
    />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DiscVault" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage.url} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content={content.seo.ogAlt} />
    <meta
      property="og:locale"
      content={ogLocale[content.locale as keyof typeof ogLocale] ?? 'en_GB'}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.url} />
    {
      productSchema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{content.a11y.skip}</a>
    <slot />
  </body>
</html>
